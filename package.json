{
  "name": "dsh-ballute",
  "version": "0.1.1",
  "description": "Ballute 气囊：插件崩坏防护——崩溃可见、可归因、可恢复",
  "type": "module",
  "license": "MIT",
  "author": "Zlyraz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zlyraz/dsh-ballute.git"
  },
  "homepage": "https://github.com/Zlyraz/dsh-ballute#readme",
  "bugs": "https://github.com/Zlyraz/dsh-ballute/issues",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "fixtures",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
